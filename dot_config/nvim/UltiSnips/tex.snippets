# Ported from the user's Obsidian LaTeX Suite snippets.
# Variable regexes expanded from upstream defaults (2026-11-12):
# https://github.com/artisticat1/obsidian-latex-suite/blob/main/src/default_snippet_variables.js
# Tab expands/jumps forward; Shift-Tab jumps backward (current key mappings).
# Pairing is handled by nvim-autopairs. Visual wrappers are manual.
# iint and iiint are manual so iint cannot expand before iiint is finished.

global !p
import re
import vim

def in_comment():
    return int(vim.eval('vimtex#syntax#in_comment()')) != 0

def in_math():
    return not in_comment() and int(vim.eval('vimtex#syntax#in_mathzone()')) != 0

def in_text():
    # Also exclude text arguments nested inside math, e.g. \\text{...}.
    return not in_comment() and not any(
        name.startswith('texMathZone') for name in vim.eval('vimtex#syntax#stack()'))

def inline_math():
    return in_math() and any(name in ('texMathZoneLI', 'texMathZoneTI')
                             for name in vim.eval('vimtex#syntax#stack()'))

def outside_command(snip):
    # Do not expand literal shortcuts while typing a LaTeX command name.
    return re.search(r'\\[A-Za-z]*$', snip.before) is None

def identity_matrix(size):
    rows = [' & '.join('1' if row == col else '0' for col in range(size))
            for row in range(size)]
    return '\\begin{pmatrix}\n' + ' \\\\\n'.join(rows) + '\n\\end{pmatrix}'
endglobal

priority 0
context "not in_comment()"
snippet beg "begin{} / end{}" bA
\begin{$1}
	$0
\end{$1}
endsnippet

